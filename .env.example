# FantasyPros account email — this alone enumerates every league + per-league key
FP_EMAIL=you@example.com

# Optional: extra league keys not tied to the email above (comma separated)
# FP_EXTRA_KEYS=nfl~7cd9fb32-a82d-434f-9ce7-3fe8edbf9f5f

# FantasyPros public API v2 key — request at https://secure.fantasypros.com/api-keys/request/
# This is a DIFFERENT credential from the MyPlaybook league keys above.
FP_API_KEY=

# Optional: pin season/week. Both are auto-detected from the calendar when unset.
# FP_SEASON=2026
# FP_WEEK=1

# VegasEdgeFantasy session cookie — copy the `access_token` cookie value from a
# logged-in browser session. It is a JWT and expires (~30 days).
VEGAS_TOKEN=

# Optional tuning
FP_CONCURRENCY=3
FP_DELAY_MS=250

# Minimum gap in ms between FantasyPros API v2 calls (burst rate limit).
# Default 1200. Raise it if you see 429s on fp:sync.
FP_API_GAP_MS=1200
